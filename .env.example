# --- LSG Status (semáforo de servicios) ---
# URLs de los servicios a monitorear (docs de FastAPI / OpenAPI)
AUTH_DOCS_URL=https://lsg.diinf.usach.cl/lsg-auth/docs
CORE_API_DOCS_URL=https://lsg.diinf.usach.cl/lsg-core-api/docs
# Nota: lsg-estudio es una landing page estática de reclutamiento (no una API
# FastAPI con Swagger), por eso se verifica la raíz y no /docs.
ESTUDIO_DOCS_URL=https://lsg.diinf.usach.cl/lsg-estudio/

# Etiquetas legibles que se muestran en el semáforo
AUTH_LABEL=LSG-Auth
CORE_API_LABEL=LSG-Core-API
ESTUDIO_LABEL=LSG-Estudio

# Umbrales de latencia (ms) para pasar de verde -> amarillo
LATENCY_WARN_MS=300
# Umbral de latencia (ms) para pasar de amarillo -> rojo (aunque responda 200)
LATENCY_CRIT_MS=1000
# Timeout de la petición HTTP (segundos)
REQUEST_TIMEOUT_S=5

# Intervalo de refresco del frontend (ms)
POLL_INTERVAL_MS=15000

# --- Grupo Vitrina (LSG-Web: https://github.com/BlendedGames-bGames/LSG-Web) ---
# Se muestran agrupados bajo un solo semáforo con sub-círculos en el dashboard.
# Rutas verificadas contra deploy/diinf/ansible/playbooks/deploy_diinf.yml de LSG-Web
# y el nginx reverse proxy en vitrina.diinf.usach.cl. vitrina-cloud-mysql queda
# fuera de alcance (es un contenedor de BD, no expone HTTP).
VITRINA_GROUP_LABEL=Vitrina (LSG-Web)

# Frontends estáticos (Vue3): se verifica la raíz, no tienen /docs
VITRINA_DIFUSION_URL=https://vitrina.diinf.usach.cl/home/
VITRINA_DIFUSION_LABEL=Difusion
VITRINA_FRONTEND_URL=https://vitrina.diinf.usach.cl/vitrina/
VITRINA_FRONTEND_LABEL=Vitrina Frontend
VITRINA_CLOUD_WEBSITE_URL=https://vitrina.diinf.usach.cl/cloud/
VITRINA_CLOUD_WEBSITE_LABEL=Cloud Website

# APIs NestJS con Swagger UI en <prefijo>/docs
VITRINA_API_DOCS_URL=https://vitrina.diinf.usach.cl/vitrina/api/v1/docs
VITRINA_API_LABEL=Vitrina API
VITRINA_AUTH_DOCS_URL=https://vitrina.diinf.usach.cl/auth/api/v1/docs
VITRINA_AUTH_LABEL=Auth (Vitrina)

# APIs del Cloud Module (Express/Node.js): exponen /health sin autenticación
VITRINA_CLOUD_API_GET_HEALTH_URL=https://vitrina.diinf.usach.cl/cloud/api/get/health
VITRINA_CLOUD_API_GET_LABEL=Cloud API GET
VITRINA_CLOUD_API_POST_HEALTH_URL=https://vitrina.diinf.usach.cl/cloud/api/post/health
VITRINA_CLOUD_API_POST_LABEL=Cloud API POST
VITRINA_CLOUD_ATTRIBUTES_HEALTH_URL=https://vitrina.diinf.usach.cl/cloud/api/attributes/health
VITRINA_CLOUD_ATTRIBUTES_LABEL=Cloud Attributes
VITRINA_CLOUD_USER_MGMT_HEALTH_URL=https://vitrina.diinf.usach.cl/cloud/api/users/health
VITRINA_CLOUD_USER_MGMT_LABEL=Cloud User Mgmt

# --- Integración opcional con interaction_logs (FONDECYT) ---
# Si se desea persistir cada chequeo en la base de datos compartida del proyecto
LOG_TO_DB=false
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lsg
EXPERIMENT_TAG=lsg-status-monitor-v1
